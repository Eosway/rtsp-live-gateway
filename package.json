{
  "name": "@eosway/rtsp-live-gateway-workspace",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm run build:packages && pnpm run build:server && pnpm run build:playground",
    "build:packages": "pnpm --filter @eosway/rtsp-live-gateway-protocol build && pnpm --filter @eosway/rtsp-live-gateway-client build && pnpm --filter @eosway/rtsp-live-gateway-player-vue build",
    "build:playground": "pnpm --filter @eosway/rtsp-live-gateway-playground build",
    "build:server": "pnpm --filter @eosway/rtsp-live-gateway-protocol build && pnpm --filter @eosway/rtsp-live-gateway-server build",
    "check": "pnpm run tsc && pnpm run build && pnpm run test",
    "tsc": "tsc -b",
    "tsc:playground": "vue-tsc -b playground",
    "test": "pnpm -r --if-present test",
    "clean": "pnpm -r --if-present clean",
    "lint": "eslint --fix .",
    "format": "prettier --write .",
    "dev:server": "pnpm --filter @eosway/rtsp-live-gateway-server dev",
    "dev:playground": "pnpm --filter @eosway/rtsp-live-gateway-playground dev",
    "pack:player": "pnpm --filter @eosway/rtsp-live-gateway-player-vue pack",
    "docker:build": "bash scripts/build-server-image.sh",
    "docker:export": "bash scripts/export-server-image.sh",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@eslint/js": "^10.0.1",
    "@types/node": "24",
    "commit-and-tag-version": "^12.7.3",
    "eslint": "^10.5.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-vue": "^10.9.2",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "prettier": "^3.8.4",
    "rimraf": "^6.1.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.61.1",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "catalog:"
  },
  "engines": {
    "node": "^22.18.0 || >=24.0.0",
    "pnpm": ">=10.0.0"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,mts,cts,vue}": [
      "eslint --fix",
      "prettier --write"
    ],
    "!(*.js|*.mjs|*.cjs|*.ts|*.mts|*.cts|*.vue)": [
      "prettier --write --ignore-unknown"
    ]
  }
}
